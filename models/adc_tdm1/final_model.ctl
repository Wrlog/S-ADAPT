$PROJECT T-DM1 in tumour-bearing mice: plasma PK, tumour disposition, payload release and growth inhibition

$DIFFEQ_DIF

TVMM = X(14)
IF (TVMM.LT.1E-6) TVMM = 1E-6
TVL = TVMM*1E-6
RTUM = (3*TVMM/(4*PI))**THIRD/10
SURA = 6*DADC/(RTUM*RTUM)
SURD = 6*DDRUG/(RTUM*RTUM)

CPADC = X(3)/V1A
XADC = (VASA + SURA)*(CPADC*EPSADC - X(8))
XDRUG = (VASD + SURD)*(X(5)*EPSDRG - X(13))

FREEAG = AG - X(9)
BIND = KONADC*X(8)*FREEAG/EPSADC
FREETB = TUB - X(12)
BTUB = KONTUB*X(11)*FREETB
DIFFC = KDIFF*(X(13) - X(11))

K10 = CLA/V1A
K12 = CLDA/V1A
K21 = CLDA/V2A
DGEN = (KDEC + K10)*X(7)*X(3)/V1D
DTUM = KDECT*X(7)*(X(8) + X(9))
DPLAS = -(CLD1 + CLDD)/V1D*X(5) + CLDD/V1D*X(6)

XP(1) = -(K10 + K12)*X(1) + K21*X(2)
XP(2) = K12*X(1) - K21*X(2)
XP(3) = -(K10 + K12 + KDEC)*X(3) + K21*X(4) - XADC*TVL
XP(4) = K12*X(3) - K21*X(4)
XP(5) = DPLAS + DGEN - XDRUG*TVL/V1D
XP(6) = CLDD/V2D*(X(5) - X(6))
XP(7) = -KDEC*X(7)
XP(8) = XADC - BIND + KOFFAD*X(9) - KDECT*X(8)
XP(9) = BIND - (KOFFAD + KINT + KDECT)*X(9)
XP(10) = KINT*X(9) - KDEG*X(10)
XP(11) = KDEG*X(7)*X(10) - BTUB + KOFFTB*X(12) + DIFFC
XP(12) = BTUB - KOFFTB*X(12)
XP(13) = XDRUG + DTUM - DIFFC
XP(14) = (KGEX - KKILL*(X(11) + X(12)))*X(14)


$OUTPUT_GLB

BW = 0.025
MWADC = 148500
DAR0 = 3.5
V1A = V1ADC*BW
V2A = 0.0948*BW
CLA = CLADC*BW
CLDA = 0.118*BW
V1D = 3.30*BW
V2D = 2.01*BW
CLD1 = 11.29*BW
CLDD = 155*BW
KONADC = 8.88
KOFFAD = 2.328
KINT = 2.16
KDEG = 0.72
KDECT = 0.5352
KONTUB = 0.72
KOFFTB = 0.684
TUB = 65
KDIFF = 2.208
AG = 1660
RCAP = 8
RKROGH = 75
PADC = 334
PDRUG = 21000
DADC = 0.022
DDRUG = 0.25
EPSADC = 0.24
EPSDRG = 0.44
VASA = 2*PADC*RCAP/(RKROGH*RKROGH)
VASD = 2*PDRUG*RCAP/(RKROGH*RKROGH)
KGEX = LOG(2)/DTEXP
PI = 3.14159265358979
THIRD = 1.0/3.0


$OUTPUT_ICS

X(7) = X(7) + DAR0
X(14) = X(14) + TV0


$OUTPUT_EQN

if (X(1).LT.0) X(1) = 0
if (X(3).LT.0) X(3) = 0
if (X(14).LT.0) X(14) = 0

Y(1) = X(1)/V1A*MWADC/1E6
Y(2) = X(3)/V1A*MWADC/1E6
Y(3) = X(14)


$VARMOD_EQN

V(1) = (SDTT*Y(1))*(SDTT*Y(1))
V(2) = (SDADC*Y(2))*(SDADC*Y(2))
V(3) = (SDTV*Y(3))*(SDTV*Y(3))


$POPMOD_EQN
